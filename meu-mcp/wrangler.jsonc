{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meu-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "MEMORY_MANAGER",
				"class_name": "MemoryManager"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MemoryManager"]
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
